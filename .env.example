# Anthropic API key — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# Postgres connection string (Neon, via the Vercel Marketplace integration —
# auto-injected in Vercel deployments; set manually for local dev).
DATABASE_URL=

# Vercel Blob read/write token (auto-injected in Vercel deployments; set
# manually for local dev, e.g. via `vercel env pull`).
BLOB_READ_WRITE_TOKEN=

# Single-user auth gate (section 7). Use a long random value for both.
APP_PASSWORD=
SESSION_SECRET=

# Ruleset source (section 3). If unset, the app falls back to reading
# ruleset files from the local ./rules directory — useful for local dev
# without a separate ruleset repo.
RULESET_GITHUB_OWNER=
RULESET_GITHUB_REPO=
RULESET_GITHUB_REF=main
RULESET_GITHUB_PATH=rules
# Only needed for a private ruleset repo or to raise GitHub's rate limit.
RULESET_GITHUB_TOKEN=
